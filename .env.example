# Ajustes propios de cada bar.
#
# Copia este fichero como ".env" (sin extensión) en la misma carpeta y pon tus
# datos. El .env NO se sube a git: ahí van los datos del local.
#
#   copy .env.example .env
#
# Todo esto es opcional: sin .env la app arranca igual con valores genéricos,
# y el nombre del bar se puede cambiar después desde la propia app.

# Nombre del local: sale en las pantallas y en los tickets
NOMBRE_LOCAL=Mi Bar

# Dirección, solo para el ticket y la cabecera (se puede dejar vacía)
DIRECCION_LOCAL=

# Puerto en el que escucha el servidor
PUERTO=3000

# Códigos de entrada que se crean LA PRIMERA VEZ que arranca (y solo esa vez).
# Si los dejas vacíos se generan al azar y se muestran una vez por pantalla.
# Cámbialos desde Administración → Empleados en cuanto entres.
PIN_GERENTE_INICIAL=
PIN_CAMARERO_INICIAL=

# Segundos... en milisegundos: margen para considerar que una comanda idéntica
# a la misma mesa es un doble envío (por defecto 30000, o sea 30 segundos)
VENTANA_DUPLICADOS_MS=30000
